# MISA AMIS login (all three required — login is fully automatic, incl. 2FA)
MISA_USERNAME=
MISA_PASSWORD=
MISA_TOTP_SECRET=

# Supabase sink — project "Auto-assign Config" (qudnkxivfgntwvmydpkt).
# Service role key: Supabase dashboard → Project Settings → API Keys → service_role.
# Leave blank to skip the Supabase write.
