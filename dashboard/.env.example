# ── Cartrack REST API (required) ─────────────────────────────────────────────
CARTRACK_AUTH=Basic ...           # Authorization header for prod
CARTRACK_COOKIE=CTSID=...        # Session cookie for prod (optional)

CARTRACK_AUTH_UAT=Basic ...       # Authorization header for UAT
CARTRACK_COOKIE_UAT=CTSID=...    # Session cookie for UAT (optional)

# ── Cartrack Fleetweb (required for JSON-RPC: autoplan, route optimise, duplicate rejection) ──
# Same account as CARTRACK_AUTH but uses a separate web password for fleetweb login.
CARTRACK_WEB_PASS=

# JSON-RPC is now always preferred where an equivalent exists — job create/delete/
# assign/unassign, the cycle's route-timeline fetch, and the status-2 fast path. Each
# one falls back to REST on any failure, so a missing CARTRACK_WEB_PASS means slow,
# never broken. The old CREATE_JOB_RPC / ASSIGN_USE_TIMELINE opt-in flags are gone;
# delete them from the deployment environment.

# ── Driver self-claim session (Nhận Việc tab in /cham-cong) ──────────────────
# HMAC key signing the driver's session cookie so the job endpoints can trust the
# driver_id server-side (a driver can only act as themselves). Optional — falls
# back to CARTRACK_WEB_PASS if unset. Set a dedicated random value in prod.
DRIVER_SESSION_SECRET=

# Optional base-URL / country overrides for the Cartrack Driver App login used by
# the Nhận Việc tab (defaults: VN host + "VN"). See src/lib/driver-app.ts.
CARTRACK_DRIVER_APP_URL=
CARTRACK_DRIVER_APP_COUNTRY=

# ── Duplicate rejection ───────────────────────────────────────────────────────
# Driver UUID used to proxy-assign a duplicate job before rejecting it via JSON-RPC.
CARTRACK_REJECT_PROXY_DRIVER_ID=

# ── Road distance ranking ─────────────────────────────────────────────────────
# Goong.io API key for road-distance smart-assign ranking.
# Falls back to haversine if not set.
GOONG_API_KEY=

# VietMap Matrix v4 — FALLBACK, tried only for pairs Goong could not answer, so a
# healthy Goong costs exactly what it always did and this stays unused. Services
# key from https://maps.vietmap.vn/console-v2/ (the services key, never the tile
# key); server-only, never client-side.
#
# Why a second provider at all: an unanswered pair is never cached, so it is
# re-asked on every future pass and never resolves. One provider going quiet left
# ~13,000 legs permanently unpriced and unscored, and said nothing while doing it.
VIETMAP_API_KEY=

# A SECOND Goong account. Two jobs:
#  1. the /distance-checking bulk module uses it directly, so heavy batch usage
#     cannot drain the smart-assign quota;
#  2. it is the middle link of the road-distance chain — Goong, then this, then
#     VietMap — each asked only for what the previous could not answer.
#
# Why a second ACCOUNT and not just better batching: these are DAILY caps. Batching
# cut requests per day and pacing spread them across days; neither helped, because
# a daily allowance does not care how politely it is spent. Only a separate
# allowance adds headroom. Leave unset and the chain simply skips this link (it is
# never asked twice with the same key).
GOONG_API_KEY_DISTANCE=

# ── Route optimisation pilot ──────────────────────────────────────────────────
# Comma-separated driver UUIDs. After a successful assignment, delivery_route_stops_optimize
# is triggered for these drivers only.
ROUTE_OPTIMIZE_PILOT=

# ── Labcenter delivery sync (used by /api/customers POST) ────────────────────
LABCENTER_EMAIL=
LABCENTER_PASSWORD=

# ── Labcenter receptionist (used by /api/labcenter/client — client lookup) ───
LABCENTER_RECEPTIONIST_EMAIL=
LABCENTER_RECEPTIONIST_PASSWORD=

# ── Google Sheet ──────────────────────────────────────────────────────────────
# Sheet ID and GIDs are hardcoded in src/lib/sheets.ts
# Service account JSON key (single line, stringified) — required for POST /api/nghi-phep
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Supabase (see docs/driver-tat.md) ─────────────────────────────────────────
# Project ref odbmfkzkipklepmghjwj. This is what the dashboard talks to.
#
# REQUIRED by the Driver TAT module (/api/tat/*, the Hiệu Suất tab in /cham-cong).
# Without these the tab reports "chưa được cấu hình" and the nightly seal pass is a
# silent no-op — nothing breaks, but nothing is recorded either.
#
# NOTE — there are TWO Supabase projects in this repo, and they are not the same one:
#   odbmfkzkipklepmghjwj  → here. Driver TAT (tat_legs).
#   qudnkxivfgntwvmydpkt  → "Auto-assign Config". The phase-1 config mirror
#                           (locations/drivers/driver_shifts), written by
#                           misa-fetcher and read by training/. See
#                           docs/supabase-migration.md.
# tat_legs has no foreign keys into the config schema, which is what lets the two
# sit apart. When phase 3 finally wires the config store into the dashboard it will
# need its OWN variables — do not repoint these, or TAT loses its database.
#
# URL + anon key are safe for the browser; the service-role key is server-only
# (bypasses RLS) and must NEVER be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=https://odbmfkzkipklepmghjwj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Project Settings → API Keys → publishable/anon
SUPABASE_SERVICE_ROLE_KEY=          # Project Settings → API Keys → service_role (secret)

# ── Disarm alert email (Resend) ───────────────────────────────────────────────
# When the engine is found OFF during business hours (06:00–22:00 VN, every day),
# the cron emails an alert naming who turned it off. Unset RESEND_API_KEY disables
# the alert entirely (no-op). Sending requires a verified domain in Resend; until
# then ALERT_EMAIL_FROM defaults to onboarding@resend.dev (only delivers to the
# Resend account owner's address).
RESEND_API_KEY=                  # Resend API key (resend.com → API Keys)
ALERT_EMAIL_TO=long.nguyen@diag.vn          # Recipient (defaults to this if unset)
ALERT_EMAIL_FROM=Fleet Auto-Assign <onboarding@resend.dev>  # Verified sender once domain is set up

# ── Admin Zalo group (leave-submission notifications) ─────────────────────────
# When a driver submits leave via POST /api/nghi-phep, a template message is sent
# to this Zalo group. Both must be set or the notification is skipped (silent).
#   ZALO_ADMIN_BOT_TOKEN = <botId:secret> from bot.zaloplatforms.com
#   ZALO_ADMIN_CHAT_ID   = the admin group's chat_id (discover via the zalo-echo spike)
ZALO_ADMIN_BOT_TOKEN=
ZALO_ADMIN_CHAT_ID=

# ── Upstash Redis (smart-assign log storage) ──────────────────────────────────
# Vercel dashboard → Storage → Upstash → Redis → Create → Connect to project.
# The env vars below are auto-populated when you link the store.
#
# LOCAL DEV: leave these unset and every Redis-backed guard fails OPEN — create locks
# always grant, the day snapshot never caches, config invalidation skips its stamp. The
# duplicate-blocking and caching behaviour most worth testing is then unreachable in dev.
# Do NOT paste the production values here to get around that: `npm run dev` would write to
# the same keys prod uses, so a local test could hold a real branch's create lock or
# clobber the live day snapshot.
# Run the in-memory stub instead (no Docker, no account, no network):
#   node scripts/redis-stub.mjs
#   UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
#   UPSTASH_REDIS_REST_TOKEN=local
# `node scripts/redis-stub.test.mjs` checks it still answers the way @upstash/redis expects.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── KiotViet revenue bot (Zalo) ───────────────────────────────────────────────
# Powers POST /api/zalo/webhook — replies with revenue + order count on command.
#
# AUTH: two paths, tried in this order. Note that KiotViet's SSO does NOT support
# the password grant (see /.well-known/openid-configuration), so a bot cannot log
# in with a username + password. Use one of these instead:
#
#  1. PUBLIC API (preferred — self-renewing, zero upkeep)
#     KiotViet admin → Thiết lập → Thiết lập cửa hàng → Public API → enable,
#     then copy the client id/secret. The bot mints its own tokens.
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
#
#  2. SESSION TOKEN (works immediately, expires ~28 days)
#     Browser devtools on nhathuocdiag.kiotviet.vn → any XHR to api-man1 →
#     copy the Authorization bearer value (without the "Bearer " prefix).
#     Used only when the Public API vars above are blank. When it expires the bot
#     replies with a "token hết hạn" message rather than reporting 0đ.
#  3. AUTO-LOGIN (self-renewing, no Public API role needed)
#     The bot logs in with the normal KiotViet web credentials and caches the session
#     token in Redis until it expires, so the 28-day refresh stops being manual.
#     Uses the INTERNAL login (api/account/login) — the SSO has no password grant.
#     Tried after the Public API and before the pasted token below.
KIOTVIET_USERNAME=
KIOTVIET_PASSWORD=
KIOTVIET_FINGERPRINT=            # optional; sent as FingerPrintKey, blank is accepted
#
KIOTVIET_SESSION_TOKEN=
#
# Store identity — defaults shown are the current single branch; override if it moves.
KIOTVIET_RETAILER=nhathuocdiag
KIOTVIET_BRANCH_ID=95562
KIOTVIET_GROUP_ID=45

# Bot + webhook. Register the webhook once (replace <TOKEN>, <SECRET>):
#   curl -X POST "https://bot-api.zaloplatforms.com/bot<TOKEN>/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://diag-logistics.vercel.app/api/zalo/webhook?key=<SECRET>"}'
# Set this to run the revenue bot under its OWN Zalo bot (the current setup: a bot
# separate from the leave-notification one). Leave BLANK to reuse ZALO_ADMIN_BOT_TOKEN.
# A bot has ONE webhook, so giving the revenue bot its own identity keeps the two
# independent — resetting one bot's token cannot break the other's notifications.
ZALO_KIOT_BOT_TOKEN=
ZALO_KIOT_WEBHOOK_SECRET=         # any long random string; must match ?key= above
# Comma-separated chat_ids allowed to query revenue. This is the gate that matters:
# Zalo forwards messages from anyone who finds the bot, and those arrive with a valid
# secret. ZALO_ADMIN_CHAT_ID is inherited ONLY when ZALO_KIOT_BOT_TOKEN is blank — a
# bot with its own identity is a different account that may not even be in that group.
# To find a group's id: message the bot there with this unset; it replies with the id.
ZALO_KIOT_ALLOWED_CHATS=

# Daily 16:00 Asia/Ho_Chi_Minh push: GET /api/zalo/daily-report. Scheduled by a
# cron-job.org ping (console.cron-job.org) — same mechanism as the existing
# /api/assign/cron engine — NOT by the GitHub Actions workflow, whose `schedule:`
# trigger was removed after it was observed firing ~85 minutes late. The workflow
# (.github/workflows/kiotviet-daily-report.yml) is manual-only now, for dry-run
# testing; do not re-add a schedule there or the report goes out twice.
# It sends to ZALO_KIOT_ALLOWED_CHATS, the same audience as the on-demand replies.
# Add ?dry=1 to preview the message without sending.
# ZALO_REPORT_SECRET locks the endpoint. Set it here, give the SAME value to
# cron-job.org as an `Authorization: Bearer <secret>` request header, and also set it
# as a GitHub repository secret of the same name for the workflow's dry-run testing.
# Also accepted as ?key=<secret> if a header is inconvenient to configure.
# Do NOT reuse CRON_SECRET: that also guards /api/assign/cron and is presented by
# THAT endpoint's own cron-job.org ping, so changing it stops the assign engine with
# no visible error. If ZALO_REPORT_SECRET is unset the route falls back to
# CRON_SECRET; with neither set the endpoint is public and anyone with the URL can
# read your revenue.
ZALO_REPORT_SECRET=

# ── Leave-row name recovery ──────────────────────────────────────────────────
# ON unless set to "0". When a leave row's driver_id comes back blank — nearly
# always because the driver was renamed in Cartrack, which rebuilds the roster
# tab's name column and orphans every row typed against the old spelling — the
# engine resolves the typed name against the ACTIVE roster and honours the leave
# when exactly ONE working driver could be meant. It never chooses between two:
# ~12 drivers hold both a PT and a DC account under one personal name. Recovered
# rows are still reported for repair. Turn this off to go back to dropping them.
LEAVE_NAME_RECOVERY=
