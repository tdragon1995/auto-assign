# ── Cartrack REST API (required) ─────────────────────────────────────────────
CARTRACK_AUTH=Basic ...           # Authorization header for prod
CARTRACK_COOKIE=CTSID=...        # Session cookie for prod (optional)

CARTRACK_AUTH_UAT=Basic ...       # Authorization header for UAT
CARTRACK_COOKIE_UAT=CTSID=...    # Session cookie for UAT (optional)

# ── Cartrack Fleetweb (required for JSON-RPC: autoplan, route optimise, duplicate rejection) ──
# Same account as CARTRACK_AUTH but uses a separate web password for fleetweb login.
CARTRACK_WEB_PASS=

# ── Driver self-claim session (Nhận Việc tab in /cham-cong) ──────────────────
# HMAC key signing the driver's session cookie so the job endpoints can trust the
# driver_id server-side (a driver can only act as themselves). Optional — falls
# back to CARTRACK_WEB_PASS if unset. Set a dedicated random value in prod.
DRIVER_SESSION_SECRET=

# Optional base-URL / country overrides for the Cartrack Driver App login used by
# the Nhận Việc tab (defaults: VN host + "VN"). See src/lib/driver-app.ts.
CARTRACK_DRIVER_APP_URL=
CARTRACK_DRIVER_APP_COUNTRY=

# ── Duplicate rejection ───────────────────────────────────────────────────────
# Driver UUID used to proxy-assign a duplicate job before rejecting it via JSON-RPC.
CARTRACK_REJECT_PROXY_DRIVER_ID=

# ── Road distance ranking ─────────────────────────────────────────────────────
# Goong.io API key for road-distance smart-assign ranking.
# Falls back to haversine if not set.
GOONG_API_KEY=

# Dedicated Goong.io key for the /distance-checking bulk module, so heavy batch
# usage can't drain the smart-assign quota. Falls back to GOONG_API_KEY if unset.
GOONG_API_KEY_DISTANCE=

# ── Route optimisation pilot ──────────────────────────────────────────────────
# Comma-separated driver UUIDs. After a successful assignment, delivery_route_stops_optimize
# is triggered for these drivers only.
ROUTE_OPTIMIZE_PILOT=

# ── Labcenter delivery sync (used by /api/customers POST) ────────────────────
LABCENTER_EMAIL=
LABCENTER_PASSWORD=

# ── Labcenter receptionist (used by /api/labcenter/client — client lookup) ───
LABCENTER_RECEPTIONIST_EMAIL=
LABCENTER_RECEPTIONIST_PASSWORD=

# ── Google Sheet ──────────────────────────────────────────────────────────────
# Sheet ID and GIDs are hardcoded in src/lib/sheets.ts
# Service account JSON key (single line, stringified) — required for POST /api/nghi-phep
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Supabase (config store — migration from Google Sheet; see docs/supabase-migration.md) ──
# Project "Auto-assign Config" (ref qudnkxivfgntwvmydpkt, region ap-southeast-1).
# URL + anon key are safe for the browser; the service-role key is server-only (bypasses RLS)
# and must NEVER be exposed to the client. Not yet wired into the app (phase 3).
NEXT_PUBLIC_SUPABASE_URL=https://qudnkxivfgntwvmydpkt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Project Settings → API Keys → publishable/anon
SUPABASE_SERVICE_ROLE_KEY=          # Project Settings → API Keys → service_role (secret)

# ── Disarm alert email (Resend) ───────────────────────────────────────────────
# When the engine is found OFF during business hours (06:00–22:00 VN, every day),
# the cron emails an alert naming who turned it off. Unset RESEND_API_KEY disables
# the alert entirely (no-op). Sending requires a verified domain in Resend; until
# then ALERT_EMAIL_FROM defaults to onboarding@resend.dev (only delivers to the
# Resend account owner's address).
RESEND_API_KEY=                  # Resend API key (resend.com → API Keys)
ALERT_EMAIL_TO=long.nguyen@diag.vn          # Recipient (defaults to this if unset)
ALERT_EMAIL_FROM=Fleet Auto-Assign <onboarding@resend.dev>  # Verified sender once domain is set up

# ── Admin Zalo group (leave-submission notifications) ─────────────────────────
# When a driver submits leave via POST /api/nghi-phep, a template message is sent
# to this Zalo group. Both must be set or the notification is skipped (silent).
#   ZALO_ADMIN_BOT_TOKEN = <botId:secret> from bot.zaloplatforms.com
#   ZALO_ADMIN_CHAT_ID   = the admin group's chat_id (discover via the zalo-echo spike)
ZALO_ADMIN_BOT_TOKEN=
ZALO_ADMIN_CHAT_ID=

# ── Upstash Redis (smart-assign log storage) ──────────────────────────────────
# Vercel dashboard → Storage → Upstash → Redis → Create → Connect to project.
# The env vars below are auto-populated when you link the store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
