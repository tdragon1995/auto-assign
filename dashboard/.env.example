# ── Cartrack REST API (required) ─────────────────────────────────────────────
CARTRACK_AUTH=Basic ...           # Authorization header for prod
CARTRACK_COOKIE=CTSID=...        # Session cookie for prod (optional)

CARTRACK_AUTH_UAT=Basic ...       # Authorization header for UAT
CARTRACK_COOKIE_UAT=CTSID=...    # Session cookie for UAT (optional)

# ── Cartrack Fleetweb (required for JSON-RPC: autoplan, route optimise, duplicate rejection) ──
# Same account as CARTRACK_AUTH but uses a separate web password for fleetweb login.
CARTRACK_WEB_PASS=

# ── Duplicate rejection ───────────────────────────────────────────────────────
# Driver UUID used to proxy-assign a duplicate job before rejecting it via JSON-RPC.
CARTRACK_REJECT_PROXY_DRIVER_ID=

# ── Road distance ranking ─────────────────────────────────────────────────────
# Goong.io API key for road-distance smart-assign ranking.
# Falls back to haversine if not set.
GOONG_API_KEY=

# ── Route optimisation pilot ──────────────────────────────────────────────────
# Comma-separated driver UUIDs. After a successful assignment, delivery_route_stops_optimize
# is triggered for these drivers only.
ROUTE_OPTIMIZE_PILOT=

# ── Labcenter delivery sync (used by /api/customers POST) ────────────────────
LABCENTER_EMAIL=
LABCENTER_PASSWORD=

# ── Labcenter receptionist (used by /api/labcenter/client — client lookup) ───
LABCENTER_RECEPTIONIST_EMAIL=
LABCENTER_RECEPTIONIST_PASSWORD=

# ── Google Sheet ──────────────────────────────────────────────────────────────
# Sheet ID and GIDs are hardcoded in src/lib/sheets.ts
